{
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
      "#/*": ["./*"]
    },
"rootDir": ".",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true
  },
  "exclude":[
"samples/*"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "wailsjs/**/*.ts"
, "src/pages/view. vue"  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
